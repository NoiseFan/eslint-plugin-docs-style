{
  "name": "eslint-plugin-md-style",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "description": "ESLint plugin for enforcing style rules in Markdown-based documentation",
  "author": "noisefan <noisefan@163.com>",
  "license": "MIT",
  "homepage": "https://github.com/NoiseFan/eslint-plugin-md-style#readme",
  "repository": {
    "type": "git",
    "url": "git+github.com:NoiseFan/eslint-plugin-md-style.git"
  },
  "bugs": {
    "url": "https://github.com/NoiseFan/eslint-plugin-md-style/issues"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "publish:ci": "pnpm --filter eslint-plugin-md-style publish:ci",
    "release": "pnpm --filter eslint-plugin-md-style",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:lint",
    "@vitest/coverage-v8": "catalog:test",
    "eslint": "catalog:lint",
    "eslint-factory": "catalog:lint",
    "eslint-plugin-md-style": "catalog:lint",
    "lint-staged": "catalog:script",
    "simple-git-hooks": "catalog:script",
    "tsdown": "catalog:build",
    "tsx": "catalog:script",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "simple-git-hooks": {
    "generate-readme-rules": "pnpm --filter eslint-plugin-md-style gen:rules",
    "pre-commit": "pnpx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,md,yml,yaml,json}": [
      "eslint --cache --fix"
    ]
  }
}
