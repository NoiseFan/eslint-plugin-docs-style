{
  "name": "@md-style/ast",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Extends Markdown AST",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/mdast": "catalog:types",
    "@types/unist": "catalog:types",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "micromark-factory-space": "catalog:",
    "micromark-util-character": "catalog:",
    "micromark-util-types": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "micromark": "catalog:",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  }
}
